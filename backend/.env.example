# Server
PORT=5002
NODE_ENV=development

# MongoDB — leave blank to auto-use an in-memory MongoDB for local testing/demo.
# For real persistence, set this to your MongoDB connection string, e.g.:
# mongodb://localhost:27017/coal_scm_db
# mongodb+srv://<user>:<password>@<cluster>.mongodb.net/coal_scm_db
MONGO_URI=

# Auth
JWT_SECRET=change_this_to_a_long_random_secret_in_production
JWT_EXPIRES_IN=7d
